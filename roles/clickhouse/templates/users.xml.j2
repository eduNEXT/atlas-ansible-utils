<clickhouse>
    <profiles>
        <default>
            <log_queries_min_query_duration_ms>{{ CLICKHOUSE_LOG_QUERIES_MIN_DURATION_MS }}</log_queries_min_query_duration_ms>
        </default>
    </profiles>
    <users>
        {% if CLICKHOUSE_DEFAULT_USER_NAME != 'default' -%}
        <default remove="remove" />
        {% endif -%}
        <{{ CLICKHOUSE_DEFAULT_USER_NAME }}>
            <password>{{ CLICKHOUSE_DEFAULT_USER_PASSWORD }}</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </{{ CLICKHOUSE_DEFAULT_USER_NAME }}>
    </users>
</clickhouse>
