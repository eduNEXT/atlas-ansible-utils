<clickhouse>
     <http_port>{{ CLICKHOUSE_HOST_INSECURE_HTTP_PORT }}</http_port>
     <tcp_port>{{ CLICKHOUSE_INTERNAL_INSECURE_NATIVE_PORT }}</tcp_port>
     {%- for host in CLICKHOUSE_LISTEN_HOSTS %}
     <listen_host>{{ host }}</listen_host>
     {%- endfor %}
     <listen_try>1</listen_try>
 </clickhouse>
