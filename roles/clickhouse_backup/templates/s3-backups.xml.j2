<clickhouse>
    <named_collections>
        <clickhouse_backup_s3>
            <url>{% if CLICKHOUSE_BACKUP_S3_ENDPOINT | length > 0 %}{{ CLICKHOUSE_BACKUP_S3_ENDPOINT | e }}{% else %}https://s3.{{ CLICKHOUSE_BACKUP_S3_REGION | e }}.amazonaws.com/{{ CLICKHOUSE_BACKUP_S3_BUCKET_NAME | e }}/{% endif %}</url>
{% if CLICKHOUSE_BACKUP_S3_ACCESS_KEY_ID | length > 0 %}
            <access_key_id>{{ CLICKHOUSE_BACKUP_S3_ACCESS_KEY_ID | e }}</access_key_id>
            <secret_access_key>{{ CLICKHOUSE_BACKUP_S3_SECRET_ACCESS_KEY | e }}</secret_access_key>
{% else %}
            <use_environment_credentials>true</use_environment_credentials>
{% endif %}
        </clickhouse_backup_s3>
    </named_collections>
</clickhouse>
