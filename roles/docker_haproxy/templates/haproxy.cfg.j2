global
  log stdout format raw local0 info
  # The master binds privileged host ports; workers run as the unprivileged user.
  user haproxy
  group haproxy

defaults
  log     global
  # Most proxies use TCP passthrough; HTTP proxies must override mode and log option.
  mode    tcp
  option  tcplog
  option  dontlognull
  timeout connect 5000
  timeout client  50000
  timeout server  50000

listen http_ingress
  bind {{ DOCKER_HAPROXY_BIND_ADDRESS }}:80
  balance source
{% for backend in DOCKER_HAPROXY_BACKENDS %}
  server s{{ loop.index }} {{ backend }}:{{ DOCKER_HAPROXY_HTTP_PORT }} check send-proxy
{% endfor %}

listen https_ingress
  bind {{ DOCKER_HAPROXY_BIND_ADDRESS }}:443
  balance source
{% for backend in DOCKER_HAPROXY_BACKENDS %}
  server s{{ loop.index }} {{ backend }}:{{ DOCKER_HAPROXY_HTTPS_PORT }} check send-proxy
{% endfor %}
{% if DOCKER_HAPROXY_K8S_API_HOSTNAME %}
  # TLS is not terminated: only the ClientHello is inspected. Reject rules must
  # come before the accept rule.
  tcp-request inspect-delay 5s
  acl k8s_api_hostname req.ssl_sni -i {{ DOCKER_HAPROXY_K8S_API_HOSTNAME }}
{% if DOCKER_HAPROXY_K8S_API_ALLOWED_CIDRS %}
  tcp-request content reject if k8s_api_hostname !{ src {{ DOCKER_HAPROXY_K8S_API_ALLOWED_CIDRS | join(' ') }} }
{% else %}
  tcp-request content reject if k8s_api_hostname
{% endif %}
  tcp-request content accept if { req.ssl_hello_type 1 }
  use_backend k8s_api_servers if k8s_api_hostname
{% endif %}

{% if DOCKER_HAPROXY_K8S_API_HOSTNAME %}
# The kube-apiserver does not speak the PROXY protocol, so no send-proxy here.
backend k8s_api_servers
  balance roundrobin
{% for backend in DOCKER_HAPROXY_K8S_API_BACKENDS %}
  server cp{{ loop.index }} {{ backend }}:{{ DOCKER_HAPROXY_K8S_API_PORT }} check
{% endfor %}
  # Long timeouts keep idle streams (logs -f, exec, watch) open. The tunnel
  # timeout also covers the shared 443 frontend, whose client timeout is short.
  timeout server 1h
  timeout tunnel 1h
{% endif %}

{% for section in DOCKER_HAPROXY_ADDITIONAL_SECTIONS %}
{{ section }}
{% endfor %}
{% if DOCKER_HAPROXY_STATS_ENABLED | bool %}
# Expose HAProxy metrics on all host interfaces for remote Prometheus scrapers.
frontend prometheus
  bind 0.0.0.0:9100
  mode http
  option httplog
  option dontlog-normal
  http-request use-service prometheus-exporter
{% endif %}
